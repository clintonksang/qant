# ============================================================
# QuantAgent Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ============================================================
# API KEYS (Required)
# ============================================================

# Tiingo API Key (for real-time FX data)
TIINGO_KEY=your_tiingo_api_key_here

# OpenAI API Key (for AI brain/GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone API Key (for trade memory/learning)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rex-memory
ARBITRAGE_INDEX_NAME=rex-arbitrage

# ============================================================
# MT5 TRADING CONFIGURATION
# ============================================================

# Live Trading Mode (true/false)
LIVE_TRADING=false

# MT5 API URL
MT5_API_URL=https://api.ruthwestlimited.com

# Trading Volume in lots (0.01 = micro lot)
MT5_VOLUME=0.01

# Magic Number (identifies bot trades in MT5)
MT5_MAGIC=123456
